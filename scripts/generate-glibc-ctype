#!/usr/bin/env python3

# SPDX-FileCopyrightText: 2026 Iain Lane <iain@orangesquash.org.uk>
#
# SPDX-License-Identifier: GPL-3.0-or-later

"""Prints the Rust source of crates/procps/src/ps/glibc_ctype.rs, which
contains tables from glibc's locale data, on standard output.

Usage: scripts/generate-glibc-ctype <glibc source directory>

The reference container uses the glibc of the flake's nixpkgs, and the tables
must come from the same glibc, with nixpkgs' patches applied. The command
`just glibc-ctype` runs this script on that source and writes the file. The
flake's glibc-ctype check fails when the committed file differs from that
output.

The table of printable characters comes from the `print` class in
localedata/locales/i18n_ctype, which the C.UTF-8 locale and glibc's other UTF-8
locales copy. The table of widths comes from the WIDTH section of
localedata/charmaps/UTF-8. glibc generates both files from the Unicode
Character Database.
"""

import re
import sys

source = sys.argv[1]
code_point = re.compile(r"<U([0-9A-F]+)>")


def ranges_of_class(text, name):
    """The ranges of code points in the class `name` of an LC_CTYPE file."""
    lines = text.splitlines()
    start = lines.index(f"{name} /")
    body = []
    for line in lines[start + 1 :]:
        body.append(line.strip().rstrip("/"))
        if not line.rstrip().endswith("/"):
            break
    ranges = []
    for item in ";".join(body).split(";"):
        bounds = code_point.findall(item)
        if not bounds:
            continue
        first = int(bounds[0], 16)
        last = int(bounds[-1], 16)
        ranges.append((first, last))
    return merge(ranges)


def merge(ranges):
    """`ranges`, sorted, with adjacent ranges joined."""
    merged = []
    for first, last in sorted(ranges):
        if merged and first == merged[-1][1] + 1:
            merged[-1] = (merged[-1][0], last)
        else:
            merged.append((first, last))
    return merged


def widths(text):
    """The ranges of code points of the WIDTH section, with their widths."""
    lines = text.splitlines()
    start = lines.index("WIDTH")
    end = lines.index("END WIDTH")
    entries = []
    for line in lines[start + 1 : end]:
        bounds = code_point.findall(line)
        width = int(line.split()[-1])
        entries.append((int(bounds[0], 16), int(bounds[-1], 16), width))
    entries.sort()
    joined = []
    for first, last, width in entries:
        if joined and joined[-1][2] == width and first == joined[-1][1] + 1:
            joined[-1] = (joined[-1][0], last, width)
        else:
            joined.append((first, last, width))
    return joined


def hexadecimal(code):
    """`code` as a Rust literal, with a separator in a long literal."""
    if code <= 0xFFFF:
        return f"0x{code:04X}"
    return f"0x{code >> 16:04X}_{code & 0xFFFF:04X}"


def rows(items, per_row, render):
    """`items` rendered `per_row` to a line."""
    out = []
    for index in range(0, len(items), per_row):
        out.append("    " + " ".join(render(item) for item in items[index : index + per_row]))
    return "\n".join(out)


def single_match(pattern, path):
    """The group of `pattern`, which must match exactly once in `path`."""
    matches = re.findall(pattern, open(path, encoding="utf-8").read(), re.MULTILINE)
    if len(matches) != 1:
        sys.exit(f"{path}: expected one match for {pattern!r}, found {len(matches)}")
    return matches[0]


version = single_match(r'^#define VERSION "([^"]+)"$', f"{source}/version.h")
unicode_years = single_match(
    r"^Copyright © (\S+) Unicode, Inc\.$",
    f"{source}/localedata/unicode-gen/unicode-license.txt",
)
ctype = open(f"{source}/localedata/locales/i18n_ctype", encoding="utf-8").read()
charmap = open(f"{source}/localedata/charmaps/UTF-8", encoding="utf-8").read()
printable = ranges_of_class(ctype, "print")
width_ranges = widths(charmap)

print(f"""// SPDX-FileCopyrightText: {unicode_years} Unicode, Inc.
//
// SPDX-License-Identifier: Unicode-3.0

// Generated by scripts/generate-glibc-ctype from glibc {version}'s
// localedata/locales/i18n_ctype and localedata/charmaps/UTF-8, which glibc
// generates from the Unicode Character Database. Do not edit this file.

/// The ranges of code points that glibc's `iswprint` accepts in a UTF-8
/// locale, in ascending order.
#[rustfmt::skip]
pub(crate) static PRINTABLE: [(u32, u32); {len(printable)}] = [
{rows(printable, 4, lambda r: f"({hexadecimal(r[0])}, {hexadecimal(r[1])}),")}
];

/// The ranges of code points that glibc's `wcwidth` gives a width other
/// than 1 in a UTF-8 locale, with the width, in ascending order.
#[rustfmt::skip]
pub(crate) static WIDTHS: [(u32, u32, u8); {len(width_ranges)}] = [
{rows(width_ranges, 3, lambda r: f"({hexadecimal(r[0])}, {hexadecimal(r[1])}, {r[2]}),")}
];""")
