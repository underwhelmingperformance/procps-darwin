<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.underwhelmingperformance.procps-helperd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/procps-helperd</string>
	</array>
	<key>Sockets</key>
	<dict>
		<key>Listeners</key>
		<dict>
			<key>SockPathMode</key>
			<integer>438</integer>
			<key>SockPathName</key>
			<string>/var/run/procps-helperd.sock</string>
			<key>SockType</key>
			<string>stream</string>
		</dict>
	</dict>
	<key>StandardErrorPath</key>
	<string>/var/log/procps-helperd.log</string>
</dict>
</plist>
